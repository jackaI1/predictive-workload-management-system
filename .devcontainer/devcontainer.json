{
  "name": "Predictive Workload Management System",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt pytest && python examples/parse_demo.py",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Streamlit dashboard", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  }
}
